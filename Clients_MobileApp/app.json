{
  "expo": {
    "name": "YoFaSo Shop",
    "slug": "yofaso-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "yofasomobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép YoFaSo truy cập máy ảnh để chụp ảnh và nhận diện cử chỉ tay thử đồ ảo AI."
      }
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF9",
        "foregroundImage": "./assets/brand/app-icon.png"
      },
      "package": "com.yofaso.shop",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF9",
          "image": "./assets/brand/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh để thử đồ ảo.",
          "cameraPermission": "Cho phép chụp ảnh để thử đồ ảo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/app-icon.png",
          "color": "#C9A227",
          "defaultChannel": "default",
          "enableRemoteNotifications": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép YoFaSo truy cập ảnh bạn chọn.",
          "savePhotosPermission": "Cho phép lưu ảnh thử đồ vào thư viện.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "./plugins/withHandGestureCamera"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72324a07-e5c6-4bf1-b4fc-f360cac6d721"
      }
    },
    "owner": "khanhkhiemton2k4"
  }
}
