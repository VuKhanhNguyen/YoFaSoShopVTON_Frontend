{
  "expo": {
    "name": "YoFaSo Shop",
    "slug": "yofaso-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "yofasomobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF9",
        "foregroundImage": "./assets/brand/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF9",
          "image": "./assets/brand/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh để thử đồ ảo.",
          "cameraPermission": "Cho phép chụp ảnh để thử đồ ảo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép YoFaSo truy cập ảnh bạn chọn.",
          "savePhotosPermission": "Cho phép lưu ảnh thử đồ vào thư viện.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}